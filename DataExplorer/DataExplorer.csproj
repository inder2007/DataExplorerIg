<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Infragistics.WPF.Trial" Version="23.2.*" />
    <PackageReference Include="Infragistics.WPF.DataGrids.Trial" Version="23.2.*" />
    <PackageReference Include="Infragistics.WPF.Menus.Trial" Version="23.2.*" />
    <PackageReference Include="Infragistics.WPF.DataTree.Trial" Version="23.2.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="data.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
