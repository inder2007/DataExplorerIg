<Window x:Class="DataExplorer.TaskDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Details" Height="425" Width="450" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F9F9F9">
    <StackPanel Margin="20" Background="White">
        <Border BorderBrush="#EEEEEE" BorderThickness="1" Padding="20">
            <StackPanel>
                <TextBlock Text="Task Details" FontSize="20" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,20" />
                
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Task Title:" FontWeight="SemiBold" Foreground="Gray" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" Foreground="#333333" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Priority:" FontWeight="SemiBold" Foreground="Gray" />
                    <TextBlock Grid.Column="1" Text="{Binding Priority}" Foreground="#007ACC" FontWeight="Bold" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Assignee:" FontWeight="SemiBold" Foreground="Gray" />
                    <TextBlock Grid.Column="1" Text="{Binding Assignee}" Foreground="Black" />
                </Grid>
                
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Due Date (ETA):" FontWeight="SemiBold" Foreground="Gray" />
                    <TextBlock Grid.Column="1" Text="{Binding Date}" Foreground="Black" />
                </Grid>
                
                <TextBlock Text="Task Description:" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,5" />
                <TextBox Text="{Binding Description}" TextWrapping="Wrap" IsReadOnly="True" Height="70" Background="#F0F0F0" Padding="10" BorderThickness="0" />
                
                <Button Content="Close Window" Width="110" Height="30" HorizontalAlignment="Right" Margin="0,20,0,0" Padding="5" Click="CloseButton_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
