<Window x:Class="DataExplorer.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Details" Height="400" Width="450" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F9F9F9">
    <StackPanel Margin="20" Background="White">
        <Border BorderBrush="#EEEEEE" BorderThickness="1" Padding="20">
            <StackPanel>
                <TextBlock Text="Record Details" FontSize="20" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,20" />
                
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Project Name:" FontWeight="SemiBold" Foreground="Gray" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Budget Allocation:" FontWeight="SemiBold" Foreground="Gray" />
                    <TextBlock Grid.Column="1" Text="{Binding Budget, StringFormat={}{0:C0}}" />
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Current Status:" FontWeight="SemiBold" Foreground="Gray" />
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#007ACC" FontWeight="Bold" />
                </Grid>
                
                <TextBlock Text="Detailed Notes:" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,5" />
                <TextBox Text="{Binding Details}" TextWrapping="Wrap" IsReadOnly="True" Height="80" Background="#F0F0F0" Padding="10" BorderThickness="0" />
                
                <Button Content="Close Window" Width="110" Height="30" HorizontalAlignment="Right" Margin="0,20,0,0" Padding="5" Click="CloseButton_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
